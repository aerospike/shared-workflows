        <mxCell id="S6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" value="summarize.py → verdict (PASS/FAIL) +&#xa;critical/high/medium/low/total  (unique by vuln id)" vertex="1">
