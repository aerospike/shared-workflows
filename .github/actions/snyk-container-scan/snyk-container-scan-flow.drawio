        </mxCell>
        <mxCell id="secTrig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;opacity=40;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;" value="1 · TRIGGER (promotion workflow)" vertex="1">
          <mxGeometry height="180" width="1000" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="secOrch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;opacity=40;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;" value="2 · CALLER — promotion workflow (owns the gate, by severity)" vertex="1">
          <mxGeometry height="180" width="1000" x="40" y="250" as="geometry" />
        </mxCell>
        <mxCell id="secInstall" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;opacity=50;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=3;" value="3 · ACTION STEP — Install &amp; VERIFY Snyk CLI  (fail-closed trust chain)" vertex="1">
          <mxGeometry height="740" width="1000" x="40" y="460" as="geometry" />
        </mxCell>
        <mxCell id="secScan" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;opacity=40;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=3;" value="4 · ACTION STEP — scan.sh" vertex="1">
          <mxGeometry height="720" width="1000" x="40" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="secOut" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;opacity=40;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;" value="5 · ACTION OUTPUTS + caller SARIF/artifact upload" vertex="1">
          <mxGeometry height="170" width="1000" x="40" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="secGate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;opacity=50;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;" value="6 · CALLER gate — the promotion decision (by severity)" vertex="1">
          <mxGeometry height="280" width="1000" x="40" y="2180" as="geometry" />
        </mxCell>
        <mxCell id="T1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;" value="Promotion workflow tags image → PROD in JFrog&#xa;(e.g. database-docker-prod-public-local/aerospike-aql:9.2.9-3)" vertex="1">
          <mxGeometry height="50" width="360" x="360" y="80" as="geometry" />
        </mxCell>
        <mxCell id="T2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;" value="calls snyk-container-scan action&#xa;inputs: image · severity-threshold · platform · timeout" vertex="1">
          <mxGeometry height="50" width="360" x="360" y="150" as="geometry" />
        </mxCell>
        <mxCell id="O1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" value="caller step: setup-jfrog-cli (OIDC)&#xa;so this action can pull the private image" vertex="1">
          <mxGeometry height="50" width="360" x="360" y="290" as="geometry" />
        </mxCell>
        <mxCell id="O2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" value="caller runs snyk-container-scan&#xa;(image · severity-threshold · platform)" vertex="1">
          <mxGeometry height="50" width="360" x="360" y="360" as="geometry" />
        </mxCell>
        <mxCell id="V0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D79B00;fontStyle=2;" value="Always install the pinned version — never trust a snyk already on PATH.&#xa;Resolve version: snyk-cli-version input, else SNYK_CLI_DEFAULT_VERSION (pin).&#xa;Enforce 48h minimum bake (verify_cli_age.py) — refuse a day-zero release." vertex="1">
          <mxGeometry height="65" width="360" x="360" y="495" as="geometry" />
        </mxCell>
        <mxCell id="V1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;" value="Import committed snyk-code-signing.asc&#xa;(key from snyk/cli source repo)" vertex="1">
          <mxGeometry height="50" width="360" x="360" y="610" as="geometry" />
        </mxCell>
        <mxCell id="V2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D79B00;" value="imported fingerprint&#xa;== SNYK_GPG_FINGERPRINT (pin)?" vertex="1">
          <mxGeometry height="90" width="220" x="430" y="695" as="geometry" />
        </mxCell>
        <mxCell id="V3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;" value="Download release sha256sums.txt.asc&#xa;(GPG-signed checksums manifest)" vertex="1">
          <mxGeometry height="50" width="360" x="360" y="820" as="geometry" />
        </mxCell>
        <mxCell id="V4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D79B00;" value="gpg --verify&#xa;Good signature?" vertex="1">
          <mxGeometry height="80" width="200" x="440" y="905" as="geometry" />
        </mxCell>
        <mxCell id="V5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;" value="Download binary from static.snyk.io&#xa;(snyk-linux / snyk-linux-arm64 for chosen version)" vertex="1">
          <mxGeometry height="50" width="360" x="360" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="V6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D79B00;" value="sha256 ==&#xa;signed manifest?" vertex="1">
          <mxGeometry height="80" width="200" x="440" y="1095" as="geometry" />
        </mxCell>
        <mxCell id="FAIL" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" value="FAIL CLOSED&#xa;::error:: + exit 1&#xa;delete binary · never fall back&#xa;to unverified / latest" vertex="1">
          <mxGeometry height="120" width="200" x="800" y="820" as="geometry" />
        </mxCell>
        <mxCell id="S1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" value="Hide the tokens from the logs&#xa;(::add-mask:: → SNYK_TOKEN / JFROG_TOKEN print as ***)" vertex="1">
          <mxGeometry height="50" width="360" x="360" y="1262" as="geometry" />
        </mxCell>
        <mxCell id="S2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" value="Authenticate to JFrog Artifactory so Snyk can pull a private image&#xa;(a docker login to the JFrog registry — NOT Docker Hub;&#xa;username comes from the JFrog token via its tokens/me API)&#xa;login failure is only a warning — the image may be public" vertex="1">
          <mxGeometry height="74" width="360" x="360" y="1316" as="geometry" />
        </mxCell>
        <mxCell id="S3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" value="Pull the image from the registry, not the local Docker daemon&#xa;(DOCKER_HOST → dead socket; avoids a multi-arch daemon bug;&#xa;Snyk reuses the registry login from the step above)" vertex="1">
          <mxGeometry height="60" width="360" x="360" y="1392" as="geometry" />
        </mxCell>
        <mxCell id="S4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" value="Run the scan — snyk container test&#xa;(--platform, --severity-threshold) → JSON report (+ SARIF if asked)" vertex="1">
          <mxGeometry height="50" width="360" x="360" y="1455" as="geometry" />
        </mxCell>
        <mxCell id="S5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" value="Did the scan fail to run?&#xa;(snyk exit ≥ 2, or empty report)" vertex="1">
