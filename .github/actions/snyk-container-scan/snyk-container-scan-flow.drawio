        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" value="LEGEND&#xa;Box = a step    Diamond = a decision&#xa;Yellow = trust / verify step&#xa;Red = FAIL CLOSED → exit 1 (never proceed)&#xa;Green = outputs / success&#xa;Sections 1 · 2 · 6 are the CALLER (not this action)" vertex="1">
