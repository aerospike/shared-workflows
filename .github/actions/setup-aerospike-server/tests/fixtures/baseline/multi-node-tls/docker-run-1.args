--name
aerospike-1
--detach
--network
aerospike-net
-p
3000:3000
-p
4333:4333
-v
tls_server_volume_1_1:/etc/aerospike/tls
-v
server_volume_1_1:/etc/aerospike-custom
--ulimit
nofile=15000
--entrypoint
asd
aerospike.jfrog.io/database-docker-virtual/aerospike-server-enterprise:latest
--foreground
--config-file
<config-file>
