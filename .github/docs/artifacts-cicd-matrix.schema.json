{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/aerospike/shared-workflows/.github/docs/artifacts-cicd-matrix.schema.json",
	"title": "reusable_artifacts-cicd.yaml matrix-json schema",
	"type": "object",
	"required": ["include"],
	"additionalProperties": false,
	"properties": {
		"include": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["runs-on", "distro", "arch"],
				"additionalProperties": false,
				"properties": {
					"runs-on": {
						"type": "string",
						"minLength": 1,
						"description": "GitHub Actions runner label (e.g., ubuntu-22.04)"
					},
					"distro": {
						"type": "string",
						"minLength": 1,
						"description": "Distro identifier (e.g., jammy, noble, el9)"
					},
					"arch": {
						"type": "string",
						"minLength": 1,
						"description": "Architecture identifier (e.g., x86_64, arm64)"
					},
					"emulated": {
						"type": "boolean",
						"default": false,
						"description": "Whether the build is emulated (used by build scripts that support emulation)"
					}
				}
			}
		}
	},
	"examples": [
		{
			"include": [
				{
					"runs-on": "ubuntu-22.04",
					"distro": "jammy",
					"arch": "x86_64",
					"emulated": false
				},
				{
					"runs-on": "ubuntu-22.04",
					"distro": "noble",
					"arch": "x86_64",
					"emulated": false
				}
			]
		}
	]
}
